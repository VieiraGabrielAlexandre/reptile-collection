# Local development only. Every value below is a non-secret, local-only
# placeholder. Never reuse these values outside your machine.
#
# Usage: cp .env.example .env

# Compose
COMPOSE_PROJECT_NAME=reptile-collection

# Application
APP_ENV=local
LOG_LEVEL=info

# Backend
# API_PORT is the port the API listens on, both on the host (`make run`)
# and published by Docker Compose (`make up`).
API_PORT=8080
# Used by `make run` (API on the host) to reach the PostgreSQL container
# through its published port. Inside Docker Compose the API receives its own
# DATABASE_URL pointing at `postgres:5432`.
DATABASE_URL=postgres://reptile:local-dev-only-password@localhost:5433/reptile_collection?sslmode=disable

# Frontend
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=reptile_collection
POSTGRES_USER=reptile
POSTGRES_PASSWORD=local-dev-only-password
# Host port. 5433 avoids clashing with a PostgreSQL installed on the host.
POSTGRES_PORT=5433

# Keycloak (http://localhost:8081)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-admin-password
KEYCLOAK_DB_PASSWORD=local-dev-only-keycloak-password
KEYCLOAK_REALM=reptile-collection
# Password of the local test users (member@, editor@, admin@example.test).
# Must satisfy the realm password policy (12+ characters).
KEYCLOAK_TEST_USER_PASSWORD=local-dev-only-user-password

# LocalStack (http://localhost:4566) — fake credentials, never real AWS ones
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Mailpit (UI http://localhost:8025, SMTP localhost:1025)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

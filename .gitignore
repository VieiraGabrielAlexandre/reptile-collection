# =============================================================================
# Reptile Collection — files that must NEVER be committed.
#
# MUST be committed (do not ignore):
#   .env.example                    template with local-only placeholder values
#   apps/api/go.sum                 Go dependency checksums
#   apps/web/package-lock.json      npm lockfile (npm ci depends on it)
#   **/.terraform.lock.hcl          Terraform provider lock (per environment)
#   .claude/settings.json           shared Claude Code settings (if created)
#   .claude/skills/, .claude/commands/, CLAUDE.md, AGENTS.md, ROADMAP.md
# =============================================================================

# --- Secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
.secrets/
secrets/

# --- Go (apps/api) -----------------------------------------------------------
apps/api/bin/
*.test
*.out
*.prof
coverage.out
coverage.html
go.work
go.work.sum

# --- Node / frontend (apps/web) ----------------------------------------------
node_modules/
apps/web/dist/
apps/web/build/
coverage/
*.tsbuildinfo
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright (end-to-end tests, planned)
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- Terraform ---------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# tfvars may hold environment-specific or sensitive values; commit examples only.
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Logs and temporary files ------------------------------------------------
*.log
tmp/
.tmp/

# --- AI assistants: personal/local files only (shared instructions are committed)
.claude/settings.local.json
CLAUDE.local.md
.aider*

# --- Editors / IDEs ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Operating systems -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
